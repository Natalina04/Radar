# Copie para .env e preencha. O .env não é versionado (está no .gitignore).

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Opcional — sem token o GitHub limita buscas a 10/min; com token, 30/min.
# https://github.com/settings/tokens (escopo "public_repo" ou nenhum escopo, só leitura pública)
GITHUB_TOKEN=
