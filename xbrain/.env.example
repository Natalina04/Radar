# Copie para .env e preencha. O .env não é versionado (está no .gitignore).

# Opcional — sem token o GitHub limita buscas a 10/min; com token, 30/min.
# https://github.com/settings/tokens (escopo "public_repo" ou nenhum escopo, só leitura pública)
GITHUB_TOKEN=

# Caminho do banco SQLite compartilhado com o projeto radar-economia-credito.
# Se não definir, os dois projetos usam o mesmo default (~/.radar/radar.db),
# então normalmente não precisa mexer nisto.
# RADAR_DB_PATH=/caminho/compartilhado/radar.db
